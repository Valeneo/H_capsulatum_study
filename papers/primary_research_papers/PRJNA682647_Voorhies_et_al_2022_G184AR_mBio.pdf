          <rdf:li xml:lang="x-repair">Research Article</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>Histoplasma capsulatum</rdf:li>
          <rdf:li>genome assembly</rdf:li>
          <rdf:li>long-read sequencing</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
