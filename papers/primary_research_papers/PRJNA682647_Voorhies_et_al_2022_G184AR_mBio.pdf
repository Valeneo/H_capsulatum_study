      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Chromosome-Level Genome Assembly of a Human Fungal Pathogen Reveals Synteny among Geographically Distinct Species</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/mBio.02574-21</rdf:li>
        </rdf:Alt>
      </dc:identifier>
