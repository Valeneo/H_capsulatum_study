          <rdf:li>Terrance P. Shea</rdf:li>
          <rdf:li>Semar Petrus</rdf:li>
          <rdf:li>JosÃ© F. MuÃ±oz</rdf:li>
          <rdf:li>Shane Poplawski</rdf:li>
          <rdf:li>William E. Goldman</rdf:li>
          <rdf:li>Todd P. Michael</rdf:li>
          <rdf:li>Christina A. Cuomo</rdf:li>
          <rdf:li>Anita Sil</rdf:li>
          <rdf:li>Sinem Beyhan</rdf:li>
        </rdf:Seq>
      </dc:creator>
